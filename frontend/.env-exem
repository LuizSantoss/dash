# SMTP 
SMTP_HOST=mail.suaempresa.com.br
SMTP_PORT=587
SMTP_USER=nao-responda@suaempresa.com.br
SMTP_PASS=senha_do_email
EMAIL_REMETENTE=nao-responda@suaempresa.com.br

# URL Base da API Node.js
VITE_API_URL=http://localhost:3000

# Rotas de autenticação
VITE_LOGIN=/auth/login
VITE_REGISTRAR=/auth/registrar

# Rotas exclusivas de autenticação separadas por perfil
VITE_LOGIN_GERENTE=/gerente
VITE_LOGIN_RH=/rh
VITE_LOGIN_DIRETORIA=/diretoria
VITE_LOGIN_ADM=/admin

# ROtas da API requisições
VITE_API_REQ_BASE=/requisicoes
VITE_API_REQ_MINHAS=/requisicoes/minhas
VITE_API_REQ_RH=/requisicoes/rh
VITE_API_REQ_DIRETORIA=/requisicoes/diretoria
VITE_API_REQ_DIRETORIA_HISTORICO=/requisicoes/diretoria/historico

# Rotas da API para o ADM
VITE_API_AUTH_USUARIOS=/auth/usuarios
VITE_API_AUTH_ALTERAR_SENHA=/auth/usuarios/alterar-senha
VITE_API_REQ_ADM_TODAS=/requisicoes/adm/todas